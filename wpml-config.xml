<wpml-config>
    <!-- news_city: shared across languages (not translatable) -->
    <taxonomies>
        <taxonomy translate="0">news_city</taxonomy>
        <taxonomy translate="0">web_studia</taxonomy>
    </taxonomies>
    <!-- PL-only webinars — no WPML translation URLs -->
    <custom-types>
        <custom-type translate="0">webinary</custom-type>
    </custom-types>
    <custom-fields>
        <custom-field action="copy">_akademiata_news_city_slug</custom-field>
    </custom-fields>
</wpml-config>
